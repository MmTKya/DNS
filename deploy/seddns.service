[Unit]
Description=SedDNS — home DNS security node
Documentation=https://github.com/MmTKya/DNS
After=network-online.target
Wants=network-online.target
# systemd-resolved's stub listener holds port 53. The installer disables it;
# this ordering keeps a manual re-enable from racing us at boot.
After=systemd-resolved.service

# Give up and stay down rather than crash-looping into the SD card.
# These belong to [Unit]: systemd parses them nowhere else and only logs
# "Unknown key" if they are left in [Service], so the limit silently does
# nothing — which is the one situation it exists to prevent.
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
# notify rather than simple: the node tells systemd when it is genuinely
# serving, so anything ordered after it starts once DNS actually works.
Type=notify
NotifyAccess=main

# The watchdog is fed only after the node resolves a query through its own
# listener. A wedged resolver holds its socket open and answers nothing, which
# a process-liveness check cannot see; this restarts it.
WatchdogSec=45s

User=seddns
Group=seddns

ExecStart=/usr/local/bin/seddns --config /etc/seddns/seddns.yaml
ExecReload=/bin/kill -HUP $MAINPID

# always, not on-failure: a self-update finishes by exiting cleanly so the
# service manager starts the new binary. A program cannot replace the code it
# is executing, so the hand-over has to go through systemd — and on-failure
# would leave the node down after a successful update.
Restart=always
RestartSec=2s

# Binding port 53 as a non-root user, and nothing more than that. CAP_NET_ADMIN
# is added in phase 3 for gateway mode and phase 5 for WireGuard.
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE

NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM

# The only writable paths.
ReadWritePaths=/var/lib/seddns

# The resolver is what the whole LAN waits on; keep it ahead of background work
# and out of reach of the OOM killer's first pass.
Nice=-5
OOMScoreAdjust=-500

[Install]
WantedBy=multi-user.target
