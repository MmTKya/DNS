[Unit]
Description=AegisDNS — home DNS security node
Documentation=https://github.com/MmTKya/DNS
After=network-online.target
Wants=network-online.target
# systemd-resolved's stub listener holds port 53. The installer disables it;
# this ordering keeps a manual re-enable from racing us at boot.
After=systemd-resolved.service

[Service]
Type=simple
# Phase 4 switches this to Type=notify with WatchdogSec, so that a resolver
# that is alive but wedged is restarted instead of being trusted.
User=aegisdns
Group=aegisdns

ExecStart=/usr/local/bin/aegisdns --config /etc/aegisdns/aegisdns.yaml
ExecReload=/bin/kill -HUP $MAINPID

Restart=on-failure
RestartSec=2s
# Give up and stay down rather than crash-looping into the SD card.
StartLimitIntervalSec=60
StartLimitBurst=5

# Binding port 53 as a non-root user, and nothing more than that. CAP_NET_ADMIN
# is added in phase 3 for gateway mode and phase 5 for WireGuard.
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE

NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM

# The only writable paths.
ReadWritePaths=/var/lib/aegisdns

# The resolver is what the whole LAN waits on; keep it ahead of background work
# and out of reach of the OOM killer's first pass.
Nice=-5
OOMScoreAdjust=-500

[Install]
WantedBy=multi-user.target
