# Build output.
# Anchored to the repo root on purpose: a bare "seddns" pattern would also
# match the cmd/seddns source directory.
/dist/
/bin/
/seddns

# Frontend build artifacts (produced by `make web`, embedded at build time).
# The .gitkeep is tracked on purpose: //go:embed all:dist fails on a directory
# that does not exist, so a fresh checkout must still have one.
/web/dist/
/web/node_modules/
/internal/web/dist/*
!/internal/web/dist/.gitkeep

# Runtime data
*.db
*.db-wal
*.db-shm
/data/
dev.yaml

# Editor / OS
.DS_Store
*.swp
.idea/
.vscode/
